# Server
PORT=3000
NODE_ENV=development

# Comma-separated frontend origins allowed by CORS.
# In production set your real frontend URL(s), e.g.:
# CORS_ORIGINS=https://tu-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Payment provider (sandbox) — keep private/integrity keys only on the backend
PAYMENT_PROVIDER_API_URL=https://api-sandbox.example.com/v1
PAYMENT_PROVIDER_PUBLIC_KEY=pub_test_xxx
PAYMENT_PROVIDER_PRIVATE_KEY=prv_test_xxx
PAYMENT_PROVIDER_INTEGRITY_KEY=integrity_xxx
